{
  "expo": {
    "name": "IsangDiwa",
    "slug": "CapstoneMobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "puac",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "notification": {
      "icon": "./assets/splash-icon.png",
      "color": "#0D1F45"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "This app needs access to your photos to upload your ID and selfie.",
          "cameraPermission": "This app needs access to your camera to take a selfie."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "This app needs permission to add events to your calendar."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow PUAC to access your camera to scan attendance QR codes."
        }
      ],
      "expo-font"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "This app needs access to your photos to upload your ID and selfie.",
        "NSCameraUsageDescription": "This app needs access to your camera to take a selfie.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "package": "com.puac.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES",
        "RECORD_AUDIO",
        "READ_CALENDAR",
        "WRITE_CALENDAR",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "puac" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "672266d4-1660-405b-83bd-2f3ea3977040"
      }
    }
  }
}
